# Copy this file to .env to change settings. Every value here is the default.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_OLLAMA_HOST=http://localhost:11434
RAG_LLM_MODEL=llama3.2:3b
RAG_LLM_KEEP_ALIVE=30m
RAG_MAX_ANSWER_TOKENS=300
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=3
RAG_MIN_SCORE=0.2
RAG_KEYWORD_MIN_SCORE=0.1
